# Local development. Copy to .env; no AWS credentials are needed.
API_PORT=3001
CORS_ORIGIN=http://localhost:5173
STORAGE_DRIVER=json
IMAGE_STORAGE_DRIVER=local
VITE_API_BASE_URL=
# To bypass the Vite proxy and call the local API directly:
# VITE_API_BASE_URL=http://localhost:3001

# Production API settings (configure these in App Runner, not in source control).
# Set PORT to the App Runner service listener port (3001 in the included Dockerfile).
# CORS_ORIGIN=https://<your-amplify-domain>
# STORAGE_DRIVER=dynamodb
# IMAGE_STORAGE_DRIVER=s3
# AWS_REGION=<your-aws-region>
# DYNAMODB_TABLE=<your-complaints-table>
# S3_BUCKET=<your-private-image-bucket>

# Frontend production build setting. Pass as a build-time environment variable.
# VITE_API_BASE_URL=https://<your-app-runner-api-domain>

# Optional for local SDK work only; prefer IAM roles in deployed services.
# Never put AWS access keys in this file.
# AWS_REGION=us-east-1